
/* GENERAL WINDOW */
QWidget {
    background-color: #F4F8FF;
    color: #17365D;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* LOGIN CARD */
QFrame#loginCard {
    background-color: #FFFFFF;
    border: 1px solid #D8E5F5;
    border-radius: 18px;
}

/* TITLE */
QLabel#titleLabel {
    color: #145DA0;
    font-size: 27px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#subtitleLabel {
    color: #64748B;
    font-size: 13px;
    background-color: transparent;
}

/* FIELD LABELS */
QLabel#fieldLabel {
    color: #17365D;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
}

/* INPUT FIELDS */
QLineEdit {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 12px;
    min-height: 20px;
    selection-background-color: #2563EB;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}

/* LOGIN BUTTON */
QPushButton#loginButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 13px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#loginButton:hover {
    background-color: #1D4ED8;
}

QPushButton#loginButton:pressed {
    background-color: #1E40AF;
}

/* FORGOT PASSWORD AND SIGN UP */
QPushButton#linkButton {
    background-color: transparent;
    color: #2563EB;
    border: none;
    padding: 5px;
    text-align: center;
}

QPushButton#linkButton:hover {
    color: #1D4ED8;
    text-decoration: underline;
}

/* REGISTRATION DIALOG */
QDialog {
    background-color: #F4F8FF;
}


/* DASHBOARD SIDEBAR */
QFrame#sidebar {
    background-color: #123B69;
    border: none;
    border-radius: 0;
}

QLabel#sidebarTitle {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 21px;
    font-weight: bold;
}

QLabel#sidebarSubtitle {
    background-color: transparent;
    color: #D5E6FF;
    font-size: 12px;
}

/* NAVIGATION BUTTONS */
QPushButton#navButton {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    text-align: left;
    padding: 13px 12px;
    font-size: 14px;
}

QPushButton#navButton:hover {
    background-color: #24558B;
}

QPushButton#navButton[active="true"] {
    background-color: #FFFFFF;
    color: #145DA0;
    font-weight: bold;
}

/* STAFF INFORMATION */
QLabel#staffName {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
}

QLabel#staffDetails {
    background-color: transparent;
    color: #D5E6FF;
    font-size: 12px;
}

/* SIGN OUT */
QPushButton#signOutButton {
    background-color: #FFFFFF;
    color: #145DA0;
    border: none;
    border-radius: 7px;
    padding: 11px;
    font-weight: bold;
}

QPushButton#signOutButton:hover {
    background-color: #DCEBFF;
}

/* MAIN CONTENT */
QWidget#contentArea {
    background-color: #F4F8FF;
}

QLabel#pageHeading {
    background-color: transparent;
    color: #145DA0;
    font-size: 27px;
    font-weight: bold;
}

QLabel#welcomeTitle {
    background-color: transparent;
    color: #17365D;
    font-size: 21px;
    font-weight: bold;
}

QLabel#pageDescription {
    background-color: transparent;
    color: #64748B;
    font-size: 14px;
}

/* DASHBOARD CARDS */
QFrame#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #D8E5F5;
    border-radius: 12px;
}

QLabel#cardTitle {
    background-color: transparent;
    color: #145DA0;
    font-size: 17px;
    font-weight: bold;
}

QLabel#cardDescription {
    background-color: transparent;
    color: #64748B;
    font-size: 13px;
}

QLabel#moduleNotice {
    background-color: #EAF2FF;
    color: #145DA0;
    border-radius: 6px;
    padding: 12px;
    font-size: 13px;
}


/* PATIENT MANAGEMENT TABLE */

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F3F7FC;
    color: #243247;
    border: 1px solid #DCE5F0;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #DCEBFF;
    selection-color: #123B70;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 10px;
    border: none;
    border-bottom: 1px solid #EDF1F6;
}

QTableWidget::item:selected {
    background-color: #DCEBFF;
    color: #123B70;
}

QHeaderView::section {
    background-color: #EAF2FC;
    color: #244B7A;
    font-weight: bold;
    font-size: 12px;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #D4E2F3;
}

QTableCornerButton::section {
    background-color: #EAF2FC;
    border: none;
}

QTableWidget QScrollBar:vertical {
    background-color: #F5F8FC;
    width: 10px;
    margin: 0;
    border: none;
}

QTableWidget QScrollBar::handle:vertical {
    background-color: #B8CBE3;
    min-height: 25px;
    border-radius: 4px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background-color: #829FC4;
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical {
    height: 0;
}
