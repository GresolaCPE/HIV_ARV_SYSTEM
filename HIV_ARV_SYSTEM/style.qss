
/* GENERAL WINDOW */
QWidget {
    background-color: #F4F8FF;
    color: #17365D;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* LOGIN CARD */
QFrame#loginCard {
    background-color: #FFFFFF;
    border: 1px solid #D8E5F5;
    border-radius: 18px;
}

/* TITLE */
QLabel#titleLabel {
    color: #145DA0;
    font-size: 27px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#subtitleLabel {
    color: #64748B;
    font-size: 13px;
    background-color: transparent;
}

/* FIELD LABELS */
QLabel#fieldLabel {
    color: #17365D;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
}

/* INPUT FIELDS */
QLineEdit {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 12px;
    min-height: 20px;
    selection-background-color: #2563EB;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
}

/* LOGIN BUTTON */
QPushButton#loginButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 13px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#loginButton:hover {
    background-color: #1D4ED8;
}

QPushButton#loginButton:pressed {
    background-color: #1E40AF;
}

/* FORGOT PASSWORD AND SIGN UP */
QPushButton#linkButton {
    background-color: transparent;
    color: #2563EB;
    border: none;
    padding: 5px;
    text-align: center;
}

QPushButton#linkButton:hover {
    color: #1D4ED8;
    text-decoration: underline;
}

/* REGISTRATION DIALOG */
QDialog {
    background-color: #F4F8FF;
}


/* DASHBOARD SIDEBAR */
QFrame#sidebar {
    background-color: #123B69;
    border: none;
    border-radius: 0;
}

QLabel#sidebarTitle {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 21px;
    font-weight: bold;
}

QLabel#sidebarSubtitle {
    background-color: transparent;
    color: #D5E6FF;
    font-size: 12px;
}

/* NAVIGATION BUTTONS */
QPushButton#navButton {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    text-align: left;
    padding: 13px 12px;
    font-size: 14px;
}

QPushButton#navButton:hover {
    background-color: #24558B;
}

QPushButton#navButton[active="true"] {
    background-color: #FFFFFF;
    color: #145DA0;
    font-weight: bold;
}

/* STAFF INFORMATION */
QLabel#staffName {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
}

QLabel#staffDetails {
    background-color: transparent;
    color: #D5E6FF;
    font-size: 12px;
}

/* SIGN OUT */
QPushButton#signOutButton {
    background-color: #FFFFFF;
    color: #145DA0;
    border: none;
    border-radius: 7px;
    padding: 11px;
    font-weight: bold;
}

QPushButton#signOutButton:hover {
    background-color: #DCEBFF;
}

/* MAIN CONTENT */
QWidget#contentArea {
    background-color: #F4F8FF;
}

QLabel#pageHeading {
    background-color: transparent;
    color: #145DA0;
    font-size: 27px;
    font-weight: bold;
}

QLabel#welcomeTitle {
    background-color: transparent;
    color: #17365D;
    font-size: 21px;
    font-weight: bold;
}

QLabel#pageDescription {
    background-color: transparent;
    color: #64748B;
    font-size: 14px;
}

/* DASHBOARD CARDS */
QFrame#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #D8E5F5;
    border-radius: 12px;
}

QLabel#cardTitle {
    background-color: transparent;
    color: #145DA0;
    font-size: 17px;
    font-weight: bold;
}

QLabel#cardDescription {
    background-color: transparent;
    color: #64748B;
    font-size: 13px;
}

QLabel#moduleNotice {
    background-color: #EAF2FF;
    color: #145DA0;
    border-radius: 6px;
    padding: 12px;
    font-size: 13px;
}


/* PATIENT MANAGEMENT TABLE */

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F3F7FC;
    color: #243247;
    border: 1px solid #DCE5F0;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #DCEBFF;
    selection-color: #123B70;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 10px;
    border: none;
    border-bottom: 1px solid #EDF1F6;
}

QTableWidget::item:selected {
    background-color: #DCEBFF;
    color: #123B70;
}

QHeaderView::section {
    background-color: #EAF2FC;
    color: #244B7A;
    font-weight: bold;
    font-size: 12px;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #D4E2F3;
}

QTableCornerButton::section {
    background-color: #EAF2FC;
    border: none;
}

QTableWidget QScrollBar:vertical {
    background-color: #F5F8FC;
    width: 10px;
    margin: 0;
    border: none;
}

QTableWidget QScrollBar::handle:vertical {
    background-color: #B8CBE3;
    min-height: 25px;
    border-radius: 4px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background-color: #829FC4;
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#metricValue {
    color: #1769D2;
    font-size: 26px;
    font-weight: 800;
    padding-top: 4px;
}

QFrame#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #D6E3F2;
    border-radius: 14px;
}

QLabel#cardTitle {
    color: #124A9C;
    font-size: 16px;
    font-weight: 700;
}

QLabel#cardDescription {
    color: #63748B;
    font-size: 12px;
}

/* SECONDARY ACTION BUTTON (Schedule page and follow-up email dialog) */
QPushButton#primaryButton {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 2px solid #2563EB;
    border-radius: 8px;
    padding: 11px 16px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #EAF2FF;
    color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton#primaryButton:pressed {
    background-color: #DBEAFE;
}


/* =====================================================================
   POLISH: general controls (forms, dialogs, buttons, scrollbars)
   ===================================================================== */

/* Plain buttons (Close, Cancel, Export, ...) */
QPushButton {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #C9D6E8;
    border-radius: 8px;
    padding: 9px 18px;
}

QPushButton:hover {
    background-color: #EAF2FF;
    border-color: #8FB3EA;
}

QPushButton:pressed {
    background-color: #DBEAFE;
}

QPushButton:disabled {
    background-color: #EEF2F7;
    color: #9AA8BA;
    border-color: #E1E8F0;
}

/* Combo boxes, date pickers, text areas */
QComboBox, QDateEdit, QSpinBox {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 9px 12px;
    min-height: 20px;
    selection-background-color: #2563EB;
}

QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 2px solid #2563EB;
}

QComboBox:disabled, QDateEdit:disabled, QLineEdit:disabled {
    background-color: #EEF2F7;
    color: #94A3B8;
}

QLineEdit[readOnly="true"] {
    background-color: #EEF2F7;
    color: #64748B;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    selection-background-color: #DCEBFF;
    selection-color: #123B70;
    outline: none;
}

QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #2563EB;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2563EB;
}

/* Tabs inside the registration form */
QTabWidget::pane {
    border: 1px solid #D8E5F5;
    border-radius: 10px;
    background-color: #F4F8FF;
    top: -1px;
}

QTabBar::tab {
    background-color: #E3EDFA;
    color: #3D5E8C;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:hover {
    background-color: #D3E3F8;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #145DA0;
    font-weight: bold;
    border-bottom: 3px solid #2563EB;
}

QCheckBox {
    background-color: transparent;
    spacing: 8px;
}

QLabel {
    background-color: transparent;
}

QToolTip {
    background-color: #123B69;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}

/* Popup calendar */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #123B69;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 22px 5px 10px;
    min-height: 28px;
    font-weight: bold;
    text-align: center;
}

/* Keep the month/year menu chevron inside the button, aligned to its right edge. */
QCalendarWidget QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 5px;
    bottom: 0px;
    width: 10px;
    height: 10px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    padding: 4px;
    min-width: 28px;
}

QCalendarWidget QToolButton#qt_calendar_monthbutton,
QCalendarWidget QToolButton#qt_calendar_yearbutton {
    padding-right: 22px;
}

QCalendarWidget QToolButton:hover {
    background-color: #24558B;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #17365D;
}

QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #17365D;
    border: none;
    padding: 2px 6px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #17365D;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #B6C2D2;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #F1F5FA;
    width: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #B8CBE3;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #829FC4;
}

QScrollBar:horizontal {
    background-color: #F1F5FA;
    height: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #B8CBE3;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* Form dialog header band */
QFrame#dialogHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #123B69, stop:1 #1769D2);
    border-radius: 12px;
}

QLabel#dialogHeaderTitle {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 19px;
    font-weight: bold;
}

QLabel#dialogHeaderText {
    background-color: transparent;
    color: #D5E6FF;
    font-size: 12px;
}

/* Danger / delete buttons */
QPushButton#dangerButton {
    background-color: #FFFFFF;
    color: #B91C1C;
    border: 1px solid #F3B4B4;
    border-radius: 8px;
    padding: 9px 18px;
}

QPushButton#dangerButton:hover {
    background-color: #FEE2E2;
}

/* =====================================================================
   POLISH: dashboard colors
   ===================================================================== */

QFrame#heroBanner {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0F2F57, stop:1 #1B4F8A);
    border: none;
    border-radius: 12px;
}

QLabel#heroTitle {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

QLabel#heroText {
    background-color: transparent;
    color: #DCEBFF;
    font-size: 13px;
}

QLabel#heroDate {
    background-color: rgba(255, 255, 255, 40);
    color: #FFFFFF;
    border-radius: 13px;
    padding: 7px 16px;
    font-weight: bold;
}

/* Dashboard cards: one calm style, color only where it carries meaning */
QFrame#dashboardCard {
    background-color: #FFFFFF;
    border: 1px solid #DCE5F0;
    border-radius: 10px;
}

QLabel#metricValue {
    color: #0F2F57;
    font-size: 28px;
    font-weight: bold;
    padding-top: 2px;
}

QLabel#metricCaption {
    background-color: transparent;
    color: #64748B;
    font-size: 12px;
    font-weight: bold;
}

QLabel#cardTitle {
    color: #0F2F57;
    font-size: 15px;
    font-weight: bold;
}

/* Quick action buttons */
QPushButton#quickAction {
    background-color: #FFFFFF;
    color: #0F2F57;
    border: 1px solid #C9D6E8;
    border-radius: 8px;
    padding: 14px 10px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#quickAction:hover {
    background-color: #0F2F57;
    color: #FFFFFF;
    border-color: #0F2F57;
}

/* Report preview "paper" */
QTextEdit#reportPreview {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 6px;
}


/* Consistent dropdown arrow placement across all combo boxes */
QComboBox {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 34px 8px 10px;
    min-height: 22px;
    text-align: left;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #D7E1EE;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: #F1F5FB;
}
QComboBox::down-arrow {
    width: 9px;
    height: 9px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #17365D;
    border: 1px solid #CBD5E1;
    selection-background-color: #DBEAFE;
    selection-color: #123B70;
    outline: 0;
}
QPushButton#profileButton {
    background: rgba(255,255,255,0.12);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 7px;
    padding: 8px 10px;
    text-align: left;
}
QPushButton#profileButton:hover { background: rgba(255,255,255,0.22); }


/* Dashboard profile shortcut */
QPushButton#profileQuickAction {
    background-color: #EEF4FC;
    color: #123B70;
    border: 1px solid #C7D8EE;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 22px;
    text-align: left;
    font-weight: 600;
}
QPushButton#profileQuickAction:hover {
    background-color: #DCEBFF;
    border-color: #8FB5E5;
}
QPushButton#profileQuickAction:pressed {
    background-color: #C9DDF7;
}


/* FINAL CONTROL POLISH: consistent dropdown geometry and chevron alignment */
QComboBox, QDateEdit {
    padding: 8px 38px 8px 12px;
    min-height: 24px;
    border: 1px solid #C9D6E8;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #17365D;
}
QComboBox:focus, QDateEdit:focus {
    border: 2px solid #2563EB;
}
QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    margin: 1px;
    border: none;
    border-left: 1px solid #E1E8F0;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: #F5F8FC;
}
QComboBox::drop-down:hover, QDateEdit::drop-down:hover {
    background-color: #EAF2FF;
}
QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url(dropdown-chevron.svg);
    width: 12px;
    height: 8px;
}
QDateEdit::up-button, QDateEdit::down-button {
    subcontrol-origin: border;
    width: 0px;
    height: 0px;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #17365D;
    border: 1px solid #C9D6E8;
    border-radius: 6px;
    selection-background-color: #E5EFFB;
    selection-color: #123B70;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 5px 9px;
}
